# NexaCore Environment Configuration
# Copy this file to .env and fill in your values

PORT=3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nexacore

# JWT Secret - change this to a long random string in production
JWT_SECRET=nexacore_jwt_secret_change_this_in_production_2024

# SMTP (Nodemailer) - fill in your email credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender display name
MAIL_FROM=NexaCore <your-email@gmail.com>

# Contact form destination email
CONTACT_TO=hello@nexacore.com

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:3000

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# Cookie settings
COOKIE_SECURE=false
# Set to true in production with HTTPS
